{
  "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "REPLACE_WITH_INSTALLED_CHECKPOINT.safetensors"}},
  "2": {"class_type": "LoadImage", "inputs": {"image": "{{INPUT_IMAGE}}"}},
  "3": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{PROMPT}}", "clip": ["1", 1]}},
  "4": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{NEGATIVE_PROMPT}}", "clip": ["1", 1]}},
  "5": {"class_type": "VAEEncode", "inputs": {"pixels": ["2", 0], "vae": ["1", 2]}},
  "6": {"class_type": "KSampler", "inputs": {"seed": "{{SEED}}", "steps": 24, "cfg": 7, "sampler_name": "euler", "scheduler": "normal", "denoise": 0.62, "model": ["1", 0], "positive": ["3", 0], "negative": ["4", 0], "latent_image": ["5", 0]}},
  "7": {"class_type": "VAEDecode", "inputs": {"samples": ["6", 0], "vae": ["1", 2]}},
  "8": {"class_type": "SaveImage", "inputs": {"filename_prefix": "mrai/reference-image", "images": ["7", 0]}}
}
